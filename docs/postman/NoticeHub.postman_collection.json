{
  "info": {
    "name": "Notice Hub · 从登录到鉴权",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "本机服务请求示例。先登录，测试脚本自动保存Token。普通员工调用管理接口预期403。"
  },
  "item": [
    {
      "name": "01 服务就绪",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"依赖服务已就绪\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 登录（改用户名体验不同角色）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"登录成功\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.environment.set(\"token\", pm.response.json().data.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "03 当前用户与权限",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "04 工作台",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/dashboard"
      }
    },
    {
      "name": "05 通知列表",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notices?page=1&size=9"
      }
    },
    {
      "name": "06 读取一条通知",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notices/{{noticeId}}"
      }
    },
    {
      "name": "07 创建通知（编辑或管理员）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notices",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman创建的通知\",\n  \"content\": \"这是一条由接口发送的通知。\",\n  \"category\": \"技术分享\",\n  \"pinned\": false,\n  \"version\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { pm.environment.set(\"noticeId\", pm.response.json().data); }"
            ]
          }
        }
      ]
    },
    {
      "name": "08 编辑通知（本人或管理员）",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notices/{{noticeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman更新的通知\",\n  \"content\": \"更新时带上详情中的version。\",\n  \"category\": \"技术分享\",\n  \"pinned\": false,\n  \"version\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 查询用户（管理员）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/users?page=1&size=10"
      }
    },
    {
      "name": "10 查看角色（管理员）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/roles"
      }
    },
    {
      "name": "11 审计记录（管理员）",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/audit-logs?page=1&size=12"
      }
    },
    {
      "name": "12 修改本人显示名",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/profile",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayName\": \"{{displayName}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 删除本人创建的通知",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/notices/{{noticeId}}"
      }
    },
    {
      "name": "14 退出登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"退出成功\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 退出后再次请求应401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "noticehub-token",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"旧Token失效\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}